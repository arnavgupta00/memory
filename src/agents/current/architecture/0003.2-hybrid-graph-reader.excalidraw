      "locked": false,
      "fontSize": 16,
      "fontFamily": 3,
      "text": "Every session: archive + index  →  Every complete B: Contexto + coverage  →  Every complete C: Shino  →  Question arrives: keep partial tail raw → retrieve → Reader → Answer\nB3/C9 example: 1–3 Ctx₁ · 4–6 Ctx₂ · 7–9 Ctx₃ + Shino₁     |     no partial B/C flush     |     Reader and Answer run exactly once",
      "rawText": "Every session: archive + index  →  Every complete B: Contexto + coverage  →  Every complete C: Shino  →  Question arrives: keep partial tail raw → retrieve → Reader → Answer\nB3/C9 example: 1–3 Ctx₁ · 4–6 Ctx₂ · 7–9 Ctx₃ + Shino₁     |     no partial B/C flush     |     Reader and Answer run exactly once",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Every session: archive + index  →  Every complete B: Contexto + coverage  →  Every complete C: Shino  →  Question arrives: keep partial tail raw → retrieve → Reader → Answer\nB3/C9 example: 1–3 Ctx₁ · 4–6 Ctx₂ · 7–9 Ctx₃ + Shino₁     |     no partial B/C flush     |     Reader and Answer run exactly once",
      "autoResize": false,
      "lineHeight": 1.28
    },
