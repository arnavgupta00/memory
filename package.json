{
  "name": "memorybench-workspace",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "agent:build": "pnpm --dir src/agents/architecture-0003.2-hybrid-graph-reader build",
    "agent:typecheck": "pnpm --dir src/agents/architecture-0003.2-hybrid-graph-reader typecheck",
    "agent:lint": "pnpm --dir src/agents/architecture-0003.2-hybrid-graph-reader lint",
    "agent:test": "pnpm --dir src/agents/architecture-0003.2-hybrid-graph-reader test",
    "backbone:build": "pnpm --dir src/agents/current build",
    "backbone:typecheck": "pnpm --dir src/agents/current typecheck",
    "backbone:lint": "pnpm --dir src/agents/current lint",
    "backbone:test": "pnpm --dir src/agents/current test",
    "backbone:gate:recall": "pnpm --dir src/agents/current gate:recall",
    "backbone:gate:context": "pnpm --dir src/agents/current gate:context",
    "backbone:report:package": "pnpm --dir src/agents/current report:package",
    "backbone:gate:package-rebuild": "pnpm --dir src/agents/current gate:package-rebuild",
    "backbone:gate:session-routing": "pnpm --dir src/agents/current gate:session-routing",
    "ui:build": "pnpm --dir src/agents/architecture-0003.2-hybrid-graph-reader/inspector/web build",
    "ui:test": "pnpm --dir src/agents/architecture-0003.2-hybrid-graph-reader/inspector/web test"
  }
}
