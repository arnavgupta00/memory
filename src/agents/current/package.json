{
  "name": "@memorybench/contexto-shino-agent",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests inspector/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab:contexto": "tsx src/scripts/contextoLab.ts",
    "lab:contexto-target": "tsx src/scripts/contextoTargetLab.ts",
    "lab:answer": "tsx src/scripts/answerLab.ts",
    "lab:replay": "tsx src/scripts/replayContextoLab.ts",
    "gate:retrieval": "tsx src/scripts/retrievalGate.ts",
    "gate:reader": "tsx src/scripts/readerGate.ts",
    "gate:reader-replay": "tsx src/scripts/readerReplayGate.ts",
    "gate:assistant-reader-repair": "tsx src/scripts/assistantReaderRepairGate.ts",
    "verify:replay": "tsx src/scripts/verifyRunReplay.ts",
    "workflow:mermaid": "node dist/scripts/exportWorkflow.js"
  },
  "dependencies": {
    "@google/genai": "2.13.0",
    "@hono/node-server": "2.0.11",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "hono": "4.12.31",
    "js-yaml": "4.1.1",
    "openai": "6.48.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.0.15"
  }
}
