.DS_Store
.env
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]
dist/

# Downloaded benchmark material and upstream code
data/raw/
.cache/

# Mutable top-level runs are local; the definitive baseline and audit archive are tracked.
runs/*
!runs/README.md
!runs/CHECKSUMS.sha256
!runs/archive/
!runs/archive/**
!runs/baseline-canary-2-gpt-5-nano-20260722-v3/
!runs/baseline-canary-2-gpt-5-nano-20260722-v3/**
submissions/*
!submissions/.gitkeep
