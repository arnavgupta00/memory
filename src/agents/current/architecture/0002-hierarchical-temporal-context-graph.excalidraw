    {
      "id": "memory-rule-text",
      "type": "text",
      "x": 2894,
      "y": 1224,
      "width": 1202,
      "height": 232,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
